# Server configuration
DR_PORT=8080
DR_HOST=0.0.0.0
DR_LOG_LEVEL=INFO
DR_DEBUG=true
DR_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Security configuration
DR_RATE_LIMIT_GENERAL_RPM=120
DR_RATE_LIMIT_SCAN_RPM=10
DR_MAX_REQUEST_BODY_BYTES=1048576

# Authentication is handled by Cloud Run IAM in production.
# No application-layer credentials are used.

# Scan configuration
DR_SCAN_SCOPE=project
DR_TARGET_ID=your-project-id
DR_SA_EMAIL=
DR_MAX_CONCURRENT_CHECKS=10
DR_GCLOUD_TIMEOUT_SECONDS=30

# AI (Vertex Gemini) — only gemini-3.1-pro and gemini-3-flash are supported
DR_AI_MODEL=gemini-3-flash

# Export configuration
DR_GCS_EXPORT_BUCKET=
